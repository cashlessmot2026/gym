{
	"appId": "com.ironyellow.gym",
	"appName": "IronYellow Gym",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"BluetoothLe": {
			"displayStrings": {
				"scanning": "Buscando smartwatch...",
				"cancel": "Cancelar",
				"availableDevices": "Dispositivos disponibles",
				"noDeviceFound": "No se encontró ningún dispositivo"
			}
		},
		"BackgroundRunner": {
			"label": "com.ironyellow.gym.check",
			"src": "runners/background.js",
			"event": "checkIn",
			"repeat": true,
			"interval": 15,
			"autoStart": true
		},
		"LocalNotifications": {
			"iconColor": "#FFD60A",
			"sound": "alarma.wav"
		},
		"SystemBars": {
			"insetsHandling": "css",
			"initialViewportFitValueHint": "cover",
			"style": "DARK"
		}
	},
	"android": {
		"backgroundColor": "#070707"
	},
	"backgroundColor": "#070707"
}
